# Examples only: Python does not load this file automatically.
# In PowerShell use $env:NAME = "value" before launching the service.
KABYLE_CATALOG=data/catalog.demo.jsonl
KABYLE_GLOSSARY=data/glossary.json
KABYLE_RETRIEVAL=lexical
KABYLE_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KABYLE_SEMANTIC_THRESHOLD=0.60
KABYLE_LLM_ENABLED=0
KABYLE_LLM_PROVIDER=ollama
# Pour OpenAI : KABYLE_LLM_PROVIDER=openai, OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY : à définir dans le terminal uniquement, jamais dans un fichier versionné
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
A2A_PUBLIC_URL=http://127.0.0.1:8002/
KABYLE_REQUIRE_ATTESTATIONS=0
# KABYLE_ATTESTATIONS_FILE=.secrets/attestations.json
# KABYLE_TRUSTED_ISSUERS=did:key:...
